{
  "name": "JARVIS Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "JARVIS dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python --version",
  "postStartCommand": "nohup python -m http.server 8000 --directory jarvis >/tmp/jarvis-http.log 2>&1 &"
}
